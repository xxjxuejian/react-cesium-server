{
  "name": "react-cesium-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React Cesium 学习项目的独立 Node.js 后端",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx --env-file-if-exists=.env src/scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/scripts/seed.ts"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3",
    "tsx": "^4.20.0",
    "eslint": "^10.0.0",
    "@eslint/js": "^10.0.0",
    "typescript-eslint": "^8.57.0"
  }
}
